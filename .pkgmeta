package-as: GGSocialState
enable-nolib-creation: yes
enable-toc-creation: yes

externals:
  # Ace3 (GitHub: WoWUIDev/Ace3)
  libs/LibStub:
    url: https://github.com/WoWUIDev/Ace3
    path: LibStub
  libs/CallbackHandler-1.0:
    url: https://github.com/WoWUIDev/Ace3
    path: CallbackHandler-1.0
  libs/AceAddon-3.0:
    url: https://github.com/WoWUIDev/Ace3
    path: AceAddon-3.0
  libs/AceEvent-3.0:
    url: https://github.com/WoWUIDev/Ace3
    path: AceEvent-3.0
  libs/AceDB-3.0:
    url: https://github.com/WoWUIDev/Ace3
    path: AceDB-3.0
  libs/AceGUI-3.0:
    url: https://github.com/WoWUIDev/Ace3
    path: AceGUI-3.0
  libs/AceConfig-3.0:
    url: https://github.com/WoWUIDev/Ace3
    path: AceConfig-3.0
  libs/AceLocale-3.0:
    url: https://github.com/WoWUIDev/Ace3
    path: AceLocale-3.0

  # GitHub-hosted External Libraries
  libs/LibDataBroker-1.1:
    url: https://github.com/tekkub/libdatabroker-1-1
  libs/LibQTip-1.0:
    url: https://github.com/Torhal/LibQTip-1.0

  # WowAce-hosted External Libraries (no official GitHub upstream)
  libs/LibDBIcon-1.0:
    url: https://repos.wowace.com/wow/libdbicon-1-0/trunk/LibDBIcon-1.0

manual-changelog: CHANGELOG.md

ignore:
  - .github
  - .gitignore
  - .gitattributes
  - .luacheckrc
  - .pkgmeta
  - README.md
  - CHANGELOG.md
  - LICENSE
  - LICENSE.txt
  - libs/LibQTip-1.0/LibQTip-1.0.toc
  - libs/LibQTip-1.0/LibStub
